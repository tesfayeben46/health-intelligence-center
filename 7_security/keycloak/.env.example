# Keycloak, the NHDW identity provider (local setup).

# Master realm admin; rotate after first boot (OpenBao: 7_security/openbao/scripts/rotate-keycloak-admin.sh).
KC_BOOTSTRAP_ADMIN_USERNAME=keycloak_admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-keycloak-admin

# Database: Keycloak shares postgres-vault, in its own schema.
KC_DB_PASSWORD=changeme-keycloak-db-password

# Seed user passwords.
SEED_OPS_ENG_PASSWORD=changeme-ops-eng
SEED_OPS_ADM_PASSWORD=changeme-ops-adm
SEED_OPS_SEC_PASSWORD=changeme-ops-sec
SEED_DEC_PASSWORD=changeme-dec
SEED_PROD_SUBMIT_PASSWORD=changeme-prod-submit
