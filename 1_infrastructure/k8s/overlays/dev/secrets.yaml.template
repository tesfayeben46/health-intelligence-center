# ClickHouse server-side named collection for the lake. Cross-ref: same creds as
# minio-secrets (SQL reads s3(nhdw_minio,...), so no creds appear in SQL).
apiVersion: v1
kind: Secret
metadata: { name: clickhouse-named-collections, namespace: nhdw }
type: Opaque
stringData:
  named_collections.xml: |
    <clickhouse>
        <named_collections>
            <nhdw_minio>
                <access_key_id>nhdw_root</access_key_id>
                <secret_access_key>__G_MINIO_ROOT__</secret_access_key>
            </nhdw_minio>
        </named_collections>
    </clickhouse>
---
# Real Google OAuth client for the "Sign in with Google" broker, read by the
# keycloak-seed Job (setup-keycloak.py). The same creds drive the Google broker
# on both staff realms, moh-staff (internal-bi, workshop) and privileged-ops
# (admin), so all three dashboard login pages show a working "Google" button.
# Optional: an absent or placeholder value skips the social broker on both realms
# (login stays username/password and EHIA; the boot does not break).
#
# To enable Google, register these Authorized redirect URIs on the OAuth 2.0 Web
# client in the Google Cloud Console (APIs & Services, Credentials), one per
# brokered realm (Keycloak's broker callback):
#   https://keycloak.127.0.0.1.nip.io/realms/moh-staff/broker/google/endpoint
#   https://keycloak.127.0.0.1.nip.io/realms/privileged-ops/broker/google/endpoint
# then put the client id/secret here and re-run the keycloak-seed Job (overlay).
apiVersion: v1
kind: Secret
metadata: { name: keycloak-idp-secrets, namespace: nhdw }
type: Opaque
stringData:
  GOOGLE_CLIENT_ID: "__REAL:GOOGLE_CLIENT_ID|changeme-google-client-id__"
  GOOGLE_CLIENT_SECRET: "__REAL:GOOGLE_CLIENT_SECRET|changeme-google-client-secret__"
---
