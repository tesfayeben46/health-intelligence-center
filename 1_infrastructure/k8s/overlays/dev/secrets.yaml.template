  SMTP_USER: "__REAL:SMTP_USER|changeme@gmail.com__"
  SMTP_PASS: "__REAL:SMTP_PASS|changeme-gmail-app-password__"
  SMTP_FROM: "__REAL:SMTP_FROM|NHDW Alerts <changeme@gmail.com>__"
---
