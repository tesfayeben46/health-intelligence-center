# Read-only creds the in-cluster ingestor Jobs use to pull each external source
# replica. Each value must match the reader account the source provisioning
# creates (0_external/sources/<src> .env / init SQL). DHIS2 uses the seeded admin
# ('district' default). ETHIOEMR/HCMISWDM/MBRANA readers are coordinated with the
# source side by gen-secrets.sh (SRC_* env, else the placeholder below).
apiVersion: v1
kind: Secret
metadata: { name: source-creds, namespace: nhdw }
type: Opaque
stringData:
  DHIS2_USER: "admin"
  DHIS2_PASSWORD: "__REAL:DHIS2_PASSWORD|district__"
  ETHIOEMR_READER_PASSWORD: "__REAL:ETHIOEMR_READER_PASSWORD|changeme-reader-password__"
  HCMISWDM_READER_PASSWORD: "__REAL:HCMISWDM_READER_PASSWORD|changeme-nscd-reader__"
  MBRANA_READER_PASSWORD: "__REAL:MBRANA_READER_PASSWORD|changeme-mbrana-reader__"
