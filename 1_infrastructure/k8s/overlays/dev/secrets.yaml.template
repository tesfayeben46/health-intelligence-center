  # init creates the ops_gateway PG role); shared generated token, one value.
  OPS_GATEWAY_PASSWORD: "__G_OPS_GATEWAY__"
  IMPERSONATION_SECRET: "__G_IMPERSONATION__"
  # HMAC key for the hash/tokenize masking classes (app/masking.py). Optional
  # in the manifest: when absent those classes degrade to drop (fail-closed,
  # never cleartext).
  MASKING_HMAC_KEY: "__G_MASKING_HMAC__"
---
