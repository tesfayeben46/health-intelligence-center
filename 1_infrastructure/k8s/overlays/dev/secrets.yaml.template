# SeaweedFS (object store; 3_storage/seaweedfs/README.md)
# The whole S3 identity surface is this one file, mounted into the S3 gateway.
# Accounts whose consumers already hold a credential reuse the same generated
# token, so consumers need no Secret of their own:
#   ADMIN          <-> minio-secrets ROOT_*          (ClickHouse named collection, DAGs, ingestors)
#   mlflow         <-> mlflow-secrets S3_SECRET_KEY  (same token as __G_MINIO_ROOT__)
#   jupyter-sync   <-> minio-secrets PROJECT_SYNC_*  (injected into user notebook pods)
# Grant syntax: prefix grants must use the `bucket/prefix/*` glob form; the bare
# form fails closed. "Write" includes delete.
apiVersion: v1
kind: Secret
metadata: { name: seaweedfs-secrets, namespace: nhdw }
type: Opaque
stringData:
  ADMIN_ACCESS_KEY: "nhdw_root"
  ADMIN_SECRET_KEY: "__G_MINIO_ROOT__"
  # Filer metadata store role in postgres-vault. Cross-ref: postgres-vault-secrets
  # SEAWEEDFS_FILER_DB_PASSWORD (the init script creates the role with it).
  FILER_DB_PASSWORD: "__G_SEAWEED_FILER_DB__"
  identities.json: |
    {
      "identities": [
        {
          "name": "nhdw_root",
          "credentials": [{ "accessKey": "nhdw_root", "secretKey": "__G_MINIO_ROOT__" }],
          "actions": ["Admin", "Read", "Write", "List", "Tagging"]
        },
        {
          "name": "mlflow",
          "credentials": [{ "accessKey": "mlflow", "secretKey": "__G_MINIO_ROOT__" }],
          "actions": ["Read:nhdw-artifacts", "Write:nhdw-artifacts", "List:nhdw-artifacts", "Tagging:nhdw-artifacts"]
        },
        {
          "name": "jupyter-sync",
          "credentials": [{ "accessKey": "jupyter-sync", "secretKey": "__G_PROJECT_SYNC__" }],
          "actions": ["Read:nhdw-artifacts/projects/*", "Write:nhdw-artifacts/projects/*", "List:nhdw-artifacts/projects/*"]
        },
        {
          "name": "anonymous",
          "actions": ["Read:nhdw-static", "List:nhdw-static"]
        }
      ]
    }
---
# Platform service-account PAT (act-as-owner). The same token is read by the
# security-seed Job (registers sha256(secret) as an R-SERVICE api_token row) and
# by background callers (scheduled reports / provisioning) that present it as the
# Bearer plus X-Act-As-Owner: <kc_sub>. Fixed 8-char prefix `svcadmin`; the secret
# part is generated per deploy. R-SERVICE holds only the act_as_owner capability.
apiVersion: v1
kind: Secret
metadata: { name: nhdw-service-token, namespace: nhdw }
type: Opaque
stringData:
  SERVICE_PAT: "nhdw_pat_svcadmin___G_SERVICE_PAT__"
---
