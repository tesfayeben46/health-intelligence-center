# secrets.yaml.template: the committed scaffold of every Kubernetes Secret the
# deploy needs. bundle/scripts/gen-secrets.sh renders it into the gitignored
# overlays/dev/secrets.yaml, substituting two kinds of placeholder token:
#   * a generated token (G_ prefix, double-underscore wrapped) becomes a fresh
#     random hex value, one per unique token; a token reused below shares one
#     value, so a cross-referenced credential cannot drift. The FERNET token
#     becomes a valid urlsafe-base64 Fernet key.
#   * a real token (real: prefix with a NAME and a |default) takes the
#     third-party credential from env $NAME, else the value in an existing
#     secrets.yaml, else the changeme default shown. Consumers of these are
#     optional, so an absent or placeholder value degrades gracefully.
# Fixed non-secret values (usernames, hosts) are literal.
#
# This file contains no secret material. The generator never overwrites an
# existing secrets.yaml, so it cannot rotate a live cluster's passwords out from
# under its already initialised databases.
apiVersion: v1
kind: Secret
metadata: { name: minio-secrets, namespace: nhdw }
type: Opaque
stringData:
  ROOT_USER: "nhdw_root"
  ROOT_PASSWORD: "__G_MINIO_ROOT__"
  # Least-privilege project-sync identity (JupyterLab labs), scoped to
  # nhdw-artifacts/projects/* in seaweedfs-secrets identities.json. These creds
  # are injected into user notebook pods, so they must never be the root pair.
  PROJECT_SYNC_ACCESS_KEY: "jupyter-sync"
  PROJECT_SYNC_SECRET_KEY: "__G_PROJECT_SYNC__"
---
apiVersion: v1
kind: Secret
metadata: { name: mlflow-secrets, namespace: nhdw }
type: Opaque
stringData:
  # Dedicated S3 identity for MLflow artifacts (declared in seaweedfs-secrets).
  S3_ACCESS_KEY: "mlflow"
  # Cross-ref: equals minio-secrets ROOT_PASSWORD (shared generated token).
  S3_SECRET_KEY: "__G_MINIO_ROOT__"
---
apiVersion: v1
kind: Secret
metadata: { name: clickhouse-secrets, namespace: nhdw }
type: Opaque
stringData:
  PASSWORD: "__G_CLICKHOUSE__"
---
apiVersion: v1
kind: Secret
metadata: { name: jupyterhub-secrets, namespace: nhdw }
type: Opaque
stringData:
  # Confidential OIDC client secret (moh-staff/jupyterhub); keycloak-seed
  # reads it as JUPYTERHUB_OIDC_SECRET and seeds the client to match.
  OIDC_CLIENT_SECRET: "__G_JUPYTERHUB_OIDC__"
  # Hub service token shared with the gateway (its JUPYTERHUB_API_TOKEN):
  # one generated value on both sides so the spawn proxy cannot drift.
  API_TOKEN: "__G_JUPYTERHUB_API__"
  # 32-byte hex key encrypting auth_state at rest. Required with
  # enable_auth_state=True: the hub reads realm roles from auth_state to gate
  # the profile picker, and without the key it crash-loops on boot.
  CRYPT_KEY: "__G_JUPYTERHUB_CRYPT__"
---
