# MLflow tracking and registry (local setup): metadata in postgres-vault,
# artifacts in the object store (SeaweedFS S3 API; MINIO_* names are historical).

# Metadata DB: own user inside postgres-vault, schema mlflow_metadata.
MLFLOW_DB_PASSWORD=changeme-mlflow-db

# Object-store credentials (transformer service account).
MINIO_ENDPOINT=http://seaweedfs-s3.nhdw.svc.cluster.local:8333
MINIO_ACCESS_KEY=nhdw_transformer
MINIO_SECRET_KEY=changeme-from-minio-env
