# DHIS2 ingestor environment.
# Copy to .env (gitignored) and fill in the changeme- values.

# DHIS2 source
# In-network default: the 0_external/sources/DHIS2/ replica on nhdw_net:
DHIS2_BASE_URL=http://dhis2-web:8080
DHIS2_USER=admin
DHIS2_PASSWORD=district
# To point at another DHIS2 instance:
#   DHIS2_BASE_URL=https://dhis2.example.org
#   plus a user and password issued for it.

# DHIS2 API behavior
# Page size for metadata endpoints (50-1000 is typical).
DHIS2_PAGE_SIZE=200
# How far back to pull on the very first run when no watermark exists.
DHIS2_INITIAL_LAST_UPDATED=2020-01-01
# Request timeout (seconds).
DHIS2_TIMEOUT=120

# Dev-only bounding (leave empty for full runs)
# data_value_sets covers the country-wide tree for every dataSet, which can be
# multi-GB per response on a large DHIS2. These keep the dev pull small:
#   DHIS2_DEV_ROOT_OU      restrict the orgUnit subtree (e.g. one region id)
#   DHIS2_DEV_START_DATE   period bracket start and end (ISO yyyy-mm-dd; Ethiopian
#   DHIS2_DEV_END_DATE     calendar on Ethiopian instances, so the max day is 30)
#   DHIS2_DEV_MAX_ROWS     stop yielding after N rows (0 = unbounded)
# Example (Addis Ababa, EC year 2007, capped at 200k):
#   DHIS2_DEV_ROOT_OU=yY9BLUUegel
#   DHIS2_DEV_START_DATE=2007-01-01
#   DHIS2_DEV_END_DATE=2007-12-30
#   DHIS2_DEV_MAX_ROWS=200000
DHIS2_DEV_ROOT_OU=
DHIS2_DEV_START_DATE=
DHIS2_DEV_END_DATE=
DHIS2_DEV_MAX_ROWS=0

# Data lake (SeaweedFS S3; MINIO_* names are historical)
# Endpoint = the in-cluster SeaweedFS S3 gateway (Service `seaweedfs-s3`, port 8333),
# advertised over port 9000 inside nhdw_net.
MINIO_ENDPOINT=http://seaweedfs-s3.nhdw.svc.cluster.local:8333
MINIO_REGION=et-addis-1
MINIO_ACCESS_KEY=nhdw_ingestor
MINIO_SECRET_KEY=changeme-must-match-data-lake-INGESTOR_SECRET_KEY
MINIO_RAW_BUCKET=nhdw-raw

# Pipeline identity
# Prefixes dlt's internal state and shows up in _manifest.json sidecars.
DLT_PIPELINE_NAME=dhis2
