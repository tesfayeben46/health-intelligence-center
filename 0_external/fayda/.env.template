# Fayda replica: SMTP configuration template (committed; placeholders only).
#
# Copy to `0_external/fayda/.env` (gitignored), fill in values, then run
# `docker compose up -d --build`. Fayda sends its OTP codes through its own SMTP,
# separate from the NHDW gateway's smtp-secrets. The same mail account may be
# used; its credentials are copied into this config rather than shared.
#
# docker-compose.yml auto-loads ./.env and substitutes these into the container's
# environment. With SMTP unset, the OTP is still generated and logged (see the
# [fayda][DEV-ONLY] log line) but no email is delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=changeme@gmail.com
SMTP_PASS=changeme-app-password
SMTP_FROM=Fayda Verification <changeme@gmail.com>
