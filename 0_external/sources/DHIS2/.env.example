# DHIS2 source replica: credential and connection record.
#
# Copy to .env (gitignored) and fill in values. docker-compose.yml reads the DB
# values from these variables (with matching inline defaults); the scripts read
# the rest.

# Public endpoint (served behind nginx with TLS)
DHIS2_BASE_URL=https://dhis2.example.org
# Container-name URL, valid only on a network shared with dhis2-web:
DHIS2_INTERNAL_URL=http://dhis2-web:8080

# Admin (privileged; UI + API administration)
DHIS2_ADMIN_USER=admin
DHIS2_ADMIN_PASSWORD=changeme-strong-admin-password

# Read/export service account (OpenFn + internal ingestor)
DHIS2_READER_USER=openfn
DHIS2_READER_PASSWORD=changeme-reader-password

# PostgreSQL backend (PostGIS), exposed on 127.0.0.1 only
DHIS2_DB_HOST=127.0.0.1
DHIS2_DB_PORT=5433
DHIS2_DB_NAME=dhis2
DHIS2_DB_USER=dhis
# INVARIANT: this sets dhis2-db POSTGRES_PASSWORD on first init and must match
# connection.password in config/dhis.conf. dhis2-web reads the mounted dhis.conf
# and ignores DHIS2_DATABASE_PASSWORD while it is mounted.
DHIS2_DB_PASSWORD=dhis

# Host data directory
DHIS2_DATA_DIR=/data/warehouse/dhis2
