# Source: HCMIS WDM (EPSS Health Commodity Management Information System,
#         Warehouse Data Management)
# Purpose: stands in for the EPSS supply-chain database (vaccine and medical
#          supply logistics across the central warehouse, hubs and facilities).
#          Schema from a backup; all rows are synthetic.
#
# Real-world equivalent connection:
#   SQL Server: jdbc:sqlserver://<hcmis-host>:1433;databaseName=HCMISWDM
#               (or through an SSH tunnel to the host running SQL Server)
#
# Copy to a sibling .env file (gitignored) and replace the values.

# SQL Server container (sa = admin; used by restore.sh and the synthesizers)
HCMISWDM_SA_PASSWORD=ChangeMe-MUST-be-strong-Aa1!

# Read-only service users used by the ingestor
# Login names (nscd_reader, openfn_nscd) follow the upstream system's naming.
HCMISWDM_NSCD_READER_PASSWORD=changeme-nscd-reader
HCMISWDM_OPENFN_READER_PASSWORD=ChangeMe-openfn-Aa1!

# Host data directory (removed by scripts/reset.sh)
HCMISWDM_DATA_DIR=/data/sources/HCMISWDM/data

# Public endpoint advertised to the ingestor
HCMISWDM_HOST=127.0.0.1
HCMISWDM_PORT=1433
HCMISWDM_DATABASE=HCMISWDM

# Synthesis controls (used by scripts/synthesize.py and
# scripts/synthesize_analytics.py)
# How many facilities to populate. "all" loads every facility from
# bundle/seeds/entity-model/_build/facilities.json (893). A numeric value
# samples that many rows (clamped to the population size).
SYNTH_FACILITY_COUNT=all
# Years of monthly history to generate (3 means 36 months back from the run date).
SYNTH_YEARS_HISTORY=3
# Random seed (defaults to the entity-model random_seed: 20260624).
SYNTH_RANDOM_SEED=20260624
# Hard cap on Fact.DailyRecord rows. Natural count at 19 hubs x 34
# commodities x 3 modes x 36 months is about 70k.
SYNTH_FACT_DAILY_CAP=80000
