# MFR FHIR replica: environment settings.
# Copy to .env and edit if needed.

# Host data directory. Not read by docker-compose.yml, which stores H2 and the
# Lucene index in named volumes.
MFR_DATA_DIR=./data

# H2 password (empty matches the JPA server defaults). Set one before exposing
# the server beyond the local host.
MFR_DB_PASSWORD=

# Base URL the seeder and verifier use.
MFR_FHIR_BASE=http://127.0.0.1:8093/fhir
