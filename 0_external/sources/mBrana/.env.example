# Source: mBrana (HCMISWCloud database on SQL Server)
# Purpose: stands in for the mBrana community stock-reporting platform. The
#          database is restored into the shared HCMISWDM SQL Server container
#          (hcmiswdm-sqlserver); mBrana has no compose file of its own.
#
# Real-world equivalent connection:
#   SQL Server: jdbc:sqlserver://<mbrana-host>:1433;databaseName=HCMISWCloud
#               (HCMISWCloud holds the mBrana mobile schemas (mFlowUSSD, mBrana,
#               RRF) and shared masters (AdministrativeUnit, dbo.Institution,
#               Commodity, USM.Environment, etc.))
#
# Copy to a sibling .env file (gitignored) and replace the values.

# SQL Server sa password (restore.sh, verify.sh, synthesize.py)
# Must equal HCMISWDM_SA_PASSWORD: both act on the same shared instance.
MBRANA_SA_PASSWORD=ChangeMe-strong-Aa1!

# Read-only service users used by the ingestor
MBRANA_READER_PASSWORD=changeme-mbrana-reader
MBRANA_OPENFN_PASSWORD=ChangeMe-openfn-Aa1!

# Host data directory (removed by scripts/reset.sh)
MBRANA_DATA_DIR=/data/sources/mBrana/data

# Public endpoint advertised to the ingestor
# The shared container publishes only 1433; 1434 is not served by this replica.
MBRANA_HOST=127.0.0.1
MBRANA_PORT=1434
MBRANA_DATABASE=HCMISWCloud

# Synthesis controls (scripts/synthesize.py)
# WOREDA_COUNT and FACILITIES_PER_WOREDA are read but no longer drive geography;
# see MBRANA_SYNTH_WOREDA_LIMIT / MBRANA_SYNTH_FACILITY_LIMIT in synthesize.py.
MBRANA_SYNTH_WOREDA_COUNT=50
MBRANA_SYNTH_FACILITIES_PER_WOREDA=15
MBRANA_SYNTH_MONTHS_HISTORY=24
MBRANA_SYNTH_SEED=42
