GATEWAY_URL=http://nhdw-gateway:8000

# DEV_AUTH=true   bypass OIDC and inject DEV_MOCK_USER + DEV_MOCK_ROLE on
#                 every /gw/* call. Local development only.
# DEV_AUTH=false  require a Keycloak login (admin client in the privileged-ops
#                 realm). Set the KEYCLOAK_* and OIDC_* values below.
DEV_AUTH=true
DEV_MOCK_USER=11111111-2222-3333-4444-555555555555
DEV_MOCK_ROLE=R-OPS-ADM

# Session cookie signing. Rotate in production.
SESSION_SECRET=dev-only-change-me

# Keycloak (only honored when DEV_AUTH=false).
KEYCLOAK_BASE=http://keycloak:8080
KEYCLOAK_PUBLIC_BASE=http://127.0.0.1:8090
OIDC_REALM=privileged-ops
OIDC_CLIENT_ID=admin
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8086/callback
APP_BASE=http://127.0.0.1:8086
