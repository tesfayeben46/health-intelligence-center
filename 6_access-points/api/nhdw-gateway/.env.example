OPS_GATEWAY_PASSWORD=changeme-ops-gateway
MINIO_ACCESS_KEY=nhdw_gateway
MINIO_SECRET_KEY=changeme-gateway
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9100
TRINO_USER=nhdw-gateway

# Auth mode
# Bearer tokens are always verified against Keycloak (see KEYCLOAK_ALLOWED_ISSUERS
# in app/settings.py). DEV_AUTH=true additionally accepts the header-only mock
# identity (X-Mock-User, X-Mock-Role) for local development. Never set
# DEV_AUTH=true in production.
#
# Production example. The dashboards behind /gw/* all call this gateway, so the
# realm must issue tokens whose audience is KEYCLOAK_AUDIENCE or one of
# KEYCLOAK_EXTRA_AUDIENCES. KEYCLOAK_DISCOVERY_URL is not read by app/settings.py.
#   KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/realms/moh-staff/.well-known/openid-configuration
#   KEYCLOAK_AUDIENCE=nhdw-gateway
#   DEV_AUTH=false
KEYCLOAK_DISCOVERY_URL=
KEYCLOAK_AUDIENCE=nhdw-gateway
KEYCLOAK_EXTRA_AUDIENCES=admin,workshop,internal-bi,submission-portal
DEV_AUTH=true

# OPA
OPA_URL=http://opa:8181
OPA_ENFORCE=false
